# JWT — common header fields + alg values + structure markers.
alg_none="\"alg\":\"none\""
alg_none_cap="\"alg\":\"None\""
alg_none_upper="\"alg\":\"NONE\""
alg_hs256="\"alg\":\"HS256\""
alg_hs384="\"alg\":\"HS384\""
alg_hs512="\"alg\":\"HS512\""
