alg_rs384="\"alg\":\"RS384\""
alg_rs512="\"alg\":\"RS512\""
alg_es256="\"alg\":\"ES256\""
alg_ps256="\"alg\":\"PS256\""
typ_jwt="\"typ\":\"JWT\""
typ_jose="\"typ\":\"jose\""
