# XML 1.0 / 1.1 — tags, namespaces, entity declarations.
xml_decl="<?xml version=\"1.0\"?>"
xml_enc="<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
doctype="<!DOCTYPE x SYSTEM \"x.dtd\">"
entity_decl="<!ENTITY x \"y\">"
entity_sys="<!ENTITY x SYSTEM \"file:///etc/passwd\">"
entity_ref="&x;"
cdata="<![CDATA[]]>"
xmlns="xmlns=\"http://example\""
xmlns_x="xmlns:x=\"urn:x\""
comment="<!-- -->"
pi="<?proc?>"
open_tag="<a>"
close_tag="</a>"
self_close="<a/>"
attr="a=\"b\""
single_attr="a='b'"
amp="&amp;"
lt="&lt;"
gt="&gt;"
quot="&quot;"
apos="&apos;"
numeric_ref="&#65;"
hex_ref="&#x41;"
external_dtd="<!DOCTYPE x SYSTEM \"http://attacker/x.dtd\">"
billion_laughs="&lol9;"
