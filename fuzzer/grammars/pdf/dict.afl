# PDF — structural tokens, dictionary keywords, stream filters.
pdf_hdr="%PDF-1.7\n"
pdf_hdr_bin="%\xe2\xe3\xcf\xd3\n"
obj_start="1 0 obj"
obj_end="endobj"
ref_R=" 0 R"
stream_kw="stream\n"
stream_end="\nendstream"
dict_open="<<"
dict_close=">>"
array_open="["
array_close="]"
name_slash="/"
trailer="trailer"
startxref="startxref"
eof="%%EOF"
xref="xref"
# Common name keys
type_catalog="/Type /Catalog"
type_pages="/Type /Pages"
type_page="/Type /Page"
type_font="/Type /Font"
type_action="/Type /Action"
type_annot="/Type /Annot"
type_outline="/Type /Outline"
# Filters
filter_flate="/Filter /FlateDecode"
filter_lzw="/Filter /LZWDecode"
filter_asciihex="/Filter /ASCIIHexDecode"
filter_ascii85="/Filter /ASCII85Decode"
filter_ccitt="/Filter /CCITTFaxDecode"
filter_dct="/Filter /DCTDecode"
# Action / JS / URI
action_uri="/S /URI /URI (http://)"
action_js="/S /JavaScript /JS "
action_launch="/S /Launch /F "
action_submit="/S /SubmitForm"
# Encryption
encrypt_dict="/Encrypt "
crypt_filter="/CFM /V2"
