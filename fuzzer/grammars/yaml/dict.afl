# YAML 1.2 — block + flow style markers, anchors, tags.
doc_start="---"
doc_end="..."
seq_item="- "
map_sep=": "
anchor="&a "
alias="*a"
tag_bang="!!str "
tag_bin="!!binary "
tag_custom="!tag "
flow_seq="["
flow_map="{"
flow_seq_close="]"
flow_map_close="}"
comma=","
pipe="|"
gt=">"
pipe_dash="|-"
gt_dash=">-"
true="true"
false="false"
null_kw="null"
tilde_null="~"
empty_string="\"\""
single_quote="'"
double_quote="\""
merge_key="<<"
block_scalar=": |"
folded_scalar=": >"
yaml_directive="%YAML 1.2"
tag_directive="%TAG !x! tag:example"
