# ── Database Passwords ────────────────────────────────────────────────────────
# Choose strong passwords. Used internally by Docker — you won't type these manually.
POSTGRES_PASSWORD=ChangeMe!
MONGODB_PASSWORD=ChangeMe!

# Must match the passwords above
DATABASE_URL=postgresql+asyncpg://admin:ChangeMe!@postgres:5432/security_research
MONGODB_URL=mongodb://admin:ChangeMe!@mongodb:27017/security_research?authSource=admin

# ── Security Keys ─────────────────────────────────────────────────────────────
# SECRET_KEY: long random string, doesn't need to be memorable
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-32-chars

# API_KEY: you enter this in the browser to access GENESIS
API_KEY=my-genesis-access-key-2024

# MCP_API_KEY: internal secret between backend and MCP tool server (never entered in browser)
MCP_API_KEY=my-mcp-internal-secret-2024

# ── Internal Service URLs (leave as-is for Docker) ────────────────────────────
REDIS_URL=redis://redis:6379
CHROMA_HOST=chromadb
CHROMA_PORT=8000
MCP_HOST=mcp_server
MCP_PORT=3001
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Research Limits ───────────────────────────────────────────────────────────
LLM_MAX_TOKENS=8096
LLM_TEMPERATURE=0.7
MAX_ITERATIONS=20
SCAN_TIMEOUT=3600

# ── Storage ───────────────────────────────────────────────────────────────────
# Path inside the container where scan artifacts are written (mapped via Docker volume)
STORAGE_PATH=/data/security

# ── LLM API Key (optional env override) ──────────────────────────────────────
# You can set your Azure AI Foundry or Anthropic API key here as a startup default.
# If left empty, configure it in the browser: Settings → LLM → API Key
# The browser UI always takes precedence once saved.
ANTHROPIC_API_KEY=
